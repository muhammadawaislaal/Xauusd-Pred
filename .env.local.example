# ============================================
# PROFESSIONAL TRADING DASHBOARD - BACKEND CONFIGURATION
# ============================================
# This application uses REAL market data ONLY
# No mock data is provided - Backend API is REQUIRED
# ============================================

# Backend API Server URL
# Update this to your backend server address
NEXT_PUBLIC_API_URL=http://localhost:5000

# WebSocket URL for real-time live updates
# Optional: Used for live price ticks and signal updates
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env.local:
#    cp .env.local.example .env.local
#
# 2. Update NEXT_PUBLIC_API_URL to your backend server:
#    Example: NEXT_PUBLIC_API_URL=http://192.168.1.100:5000
#
# 3. Ensure your backend server is running
#
# 4. Backend must expose:
#    - POST /api/predict (AI signal generation)
#    - GET /api/market/{asset} (live market data)
#    - GET /api/history/{asset} (prediction history)
#    - GET /api/health (health check)
#
# 5. All responses must match the API specification
#    See BACKEND_API_SPECIFICATION.md for details
#
# ============================================
# VERIFICATION
# ============================================
# The dashboard will show "Backend Unavailable" error if:
# - Backend server is not running
# - NEXT_PUBLIC_API_URL is incorrect
# - Backend is not responding to /api/health
# - Authentication token is invalid
#
# Check browser console for detailed error logs [v0] messages
# ============================================
